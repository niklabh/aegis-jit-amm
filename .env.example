# Private key for deployment (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# Sepolia RPC URL (you can get one from Alchemy, Infura, or other providers)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Optional: Etherscan API key for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Optional: WETH address for the AquaSwapVMRouter deployment
# (defaults to the canonical address on mainnet/sepolia, a WETHMock is deployed on local networks)
# WETH_ADDRESS=0x...

# World ID (optional). Register the app in the Developer Portal at https://developer.world.org (the hosted World ID
# Simulator resolves apps there) and enable World ID 4.0 / relying-party registration to get the rp_id and the signing
# key. The adapter on-chain only needs the app id; IDKit 4.x additionally needs the RP id and signing key for request
# signatures (kept in the local prover process, never in the browser). Deploy picks WORLD_ID_APP_ID, else the
# PRODUCTION_* app, else the staging-portal app.
PRODUCTION_WORLD_ID_APP_ID=app_...
PRODUCTION_WORLD_ID_RP_ID=rp_...
PRODUCTION_WORLD_ID_RP_SIGNING_KEY=
# An app from the staging portal (https://staging-developer.world.org) works on-chain too, but the hosted Simulator
# cannot resolve it (see README, Live on World Chain Sepolia).
WORLD_ID_STAGING_APP_ID=
WORLD_ID_RP_ID=
WORLD_ID_RP_SIGNING_KEY=

# World Chain Sepolia RPC (chainId 4801). Leave empty for the public Alchemy endpoint.
WORLDCHAIN_SEPOLIA_RPC_URL=
