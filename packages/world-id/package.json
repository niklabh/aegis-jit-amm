    "@semaphore-protocol/identity": "3.15.2",
    "snarkjs": "0.7.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
